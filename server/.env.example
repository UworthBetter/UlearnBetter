# UlearnBetter assistant backend — example configuration.
# Copy to server/.env and fill in real values. Never commit the real .env.

# Which provider to use: anthropic | openai | openai-compatible | google | groq
ASSISTANT_PROVIDER=anthropic

# Model id. Optional for providers that have a default (see server/README.md);
# required for openai-compatible.
# ASSISTANT_MODEL=claude-3-7-sonnet-latest

# API key. ASSISTANT_API_KEY works for any provider; provider-specific vars
# (ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY / GROQ_API_KEY) also work.
ASSISTANT_API_KEY=

# Required only for provider=openai-compatible (DeepSeek, ModelScope, Moonshot,
# local vLLM, ...). Also usable to point native providers at a proxy.
# ASSISTANT_BASE_URL=https://api.deepseek.com/v1

# Optional: enable read-only local notes retrieval, confined to this directory.
# Leave unset to disable the server-side notes tools entirely.
# ASSISTANT_NOTES_ROOT=/absolute/path/to/notes

# HTTP port (default 4000).
# PORT=4000

# Comma-separated allowed CORS origins, or * to allow all.
# Default: http://localhost:5173,http://127.0.0.1:5173 (Vite dev server).
# ASSISTANT_ALLOWED_ORIGINS=http://localhost:5173

# Max server-side tool calls per request (default 8).
# ASSISTANT_MAX_TOOL_CALLS=8

# Runtime log level: debug | info | warn | error (default warn).
# ASSISTANT_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Learning record layer (/api/record/*). Works without any ASSISTANT_* model
# configuration. No secrets here.
# ---------------------------------------------------------------------------

# Decision layer directory (goals, items, assignments, overrides, events).
# Default: server/.data/record/ (gitignored). Plain files, vault `_系统/` compatible.
# RECORD_DATA_DIR=/absolute/path/to/record

# Compiled topics directory: one sub-directory per topic with learn.json +
# manifest.json (output of tools/learning). Unset → empty topic list.
# RECORD_LEARN_DIR=/absolute/path/to/compiled-topics

# Organizer: null | folder | llm | mock   (default folder; mock is UI-dev only)
# llm uses the ASSISTANT_* model above and sends only titles, one-line
# summaries, folder names and concept labels.
# RECORD_ORGANIZER=folder

# Auto-accept threshold for organizer proposals, 0–1 (default 0.85).
# RECORD_AUTO_ACCEPT=0.85
