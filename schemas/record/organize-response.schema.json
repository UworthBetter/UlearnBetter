{
  "type": "object",
  "properties": {
    "schema": {
      "const": "learning.organize/0.1"
    },
    "organizer": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "component",
            "compiler",
            "user"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "promptVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mock": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "model",
        "promptVersion",
        "mock"
      ],
      "additionalProperties": false
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^(goal|item|topic):[A-Za-z0-9._\\-\\u4e00-\\u9fff]{1,120}$|^(concept|procedure|procitem|relation):[A-Za-z0-9._\\-\\u4e00-\\u9fff/~]{1,363}$"
          },
          "goalId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._\\-\\u4e00-\\u9fff]{1,120}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "startSec": {
                  "type": "number"
                },
                "endSec": {
                  "type": "number"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "sourceId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "subject",
          "goalId",
          "confidence",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "goalProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "fromSubjects": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(goal|item|topic):[A-Za-z0-9._\\-\\u4e00-\\u9fff]{1,120}$|^(concept|procedure|procitem|relation):[A-Za-z0-9._\\-\\u4e00-\\u9fff/~]{1,363}$"
            }
          }
        },
        "required": [
          "title",
          "intent",
          "reason",
          "fromSubjects"
        ],
        "additionalProperties": false
      }
    },
    "ideaAttachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^(goal|item|topic):[A-Za-z0-9._\\-\\u4e00-\\u9fff]{1,120}$|^(concept|procedure|procitem|relation):[A-Za-z0-9._\\-\\u4e00-\\u9fff/~]{1,363}$"
          },
          "conceptRef": {
            "type": "string",
            "pattern": "^(goal|item|topic):[A-Za-z0-9._\\-\\u4e00-\\u9fff]{1,120}$|^(concept|procedure|procitem|relation):[A-Za-z0-9._\\-\\u4e00-\\u9fff/~]{1,363}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "conceptRef",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "const": true
    }
  },
  "required": [
    "schema",
    "organizer",
    "assignments",
    "goalProposals",
    "ideaAttachments",
    "warnings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "organize-response.schema.json",
  "title": "organize-response"
}
